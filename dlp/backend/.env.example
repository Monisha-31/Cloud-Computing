PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/data_lake_pipeline
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Compaction: a partition gets compacted once it holds at least this many raw files
COMPACTION_THRESHOLD=3

# Optional — only needed for the "Push to AWS S3" feature.
# Leave blank to use the pipeline in local-storage-only mode.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
